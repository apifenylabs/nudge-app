const categories = [
  { name: "Theme Parks", icon: Sparkles, desc: "Where memories are made", color: "from-amber-400 to-orange-500", bg: "bg-amber-50 text-amber-600" },
  { name: "Parks & Nature", icon: TreePine, desc: "Fresh air, open spaces", color: "from-emerald-400 to-green-500", bg: "bg-emerald-50 text-emerald-600" },
