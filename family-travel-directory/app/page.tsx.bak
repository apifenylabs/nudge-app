const cities = ["Tokyo", "Osaka", "Nara", "Singapore"];
const featuredCities = [
  { name: "Tokyo", country: "Japan", count: 47, image: "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf", tag: "Best for: All ages" },
