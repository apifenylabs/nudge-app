# Environment variables for Directory Beast
# Copy to .env.local for local development
# These will be set automatically in production via credential system

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Mapbox for interactive maps
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Deployment
VERCEL_URL=https://familytravel.vercel.app
VERCEL_ENV=production

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=your-ga-id-here
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here