# =============================================================================
# LUXURY FAMILY TRAVEL ASIA — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NOTE: Only NEXT_PUBLIC_* vars are exposed to the browser.
# Keep server-side secrets (API keys, DB creds) out of NEXT_PUBLIC_.
# =============================================================================

# ---------------------------------------------------------------------------
# AFFILIATE PROGRAM IDs
# ---------------------------------------------------------------------------
# To activate affiliate links, uncomment and set the provider(s) you've joined.
# Until you set a var, the component falls back to plain (non-affiliate) URLs.
# See AFFILIATE_SETUP.md for sign-up instructions.

# Booking.com — sign up: https://partner.booking.com
# NEXT_PUBLIC_AFFILIATE_BOOKING_COM=book_xxx

# Klook — sign up: https://affiliate.klook.com
# NEXT_PUBLIC_AFFILIATE_KLOOK=klk_xxx

# Viator (Tripadvisor) — sign up: https://www.viator.com/affiliates
# NEXT_PUBLIC_AFFILIATE_VIATOR=viator_xxx

# Expedia — sign up: https://expediapartnersolutions.com
# NEXT_PUBLIC_AFFILIATE_EXPEDIA=exp_xxx

# GetYourGuide — sign up: https://partner.getyourguide.com
# NEXT_PUBLIC_AFFILIATE_GETYOURGUIDE=gyg_xxx

# Tripadvisor — sign up: https://www.tripadvisor.com/affiliates
# NEXT_PUBLIC_AFFILIATE_TRIPADVISOR=trip_xxx

# Agoda — sign up: https://partner.agoda.com
# NEXT_PUBLIC_AFFILIATE_AGODA=agoda_xxx

# ---------------------------------------------------------------------------
# SITE-SPECIFIC (optional)
# ---------------------------------------------------------------------------

# Google AdSense Publisher ID (already hard-coded in layout.tsx)
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# THIRD-PARTY SERVICES
# ---------------------------------------------------------------------------

# Supabase (for contact forms, reviews, etc.)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# # Google Analytics (GA4) — set in Vercel env vars for production
# Create a GA4 property: https://analytics.google.com
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Vercel Analytics & Speed Insights — enabled by default via @vercel/analytics
