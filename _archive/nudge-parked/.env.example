# Nudge - Family Task Management
# Week 2: MVP Development

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# Stripe Configuration (for billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs — create products/prices in Stripe Dashboard
# Pro Monthly: $5/month, Family Monthly: $9/month
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
NEXT_PUBLIC_STRIPE_PRICE_FAMILY_MONTHLY=price_family_monthly

# Email (Resend) — for notifications and digests
# Free tier: 100 emails/day. Sign up at https://resend.com
RESEND_API_KEY=re_your-resend-api-key
# Must be a verified domain in Resend
EMAIL_FROM=Nudge <noreply@nudge.family>
EMAIL_REPLY_TO=hello@nudge.family

# DeepSeek API (for NLP parsing) — replaces Anthropic Claude
# Get key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Local Ollama endpoint (fallback NLP parser when DeepSeek is unavailable)
# Uses qwen3-coder by default for local NLP parsing
OLLAMA_URL=http://localhost:11434
OLLAMA_NLP_MODEL=qwen3-coder:latest

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_TELEGRAM=true
NEXT_PUBLIC_ENABLE_AI_PARSING=true
NEXT_PUBLIC_ENABLE_EMAIL_NOTIFICATIONS=false

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Security
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Deployment
VERCEL_URL=your-vercel-url.vercel.app
VERCEL_GIT_COMMIT_SHA=git-commit-sha

# Development
DEBUG=true
LOG_LEVEL=info

# ============================================
# DEPLOYMENT NOTES:
# ============================================
# 1. Supabase Setup:
#    - Create project at supabase.com
#    - Run supabase-schema.sql in SQL Editor
#    - Get URL and anon key from Settings > API
#
# 2. Telegram Bot:
#    - Create bot via @BotFather on Telegram
#    - Get bot token
#    - Set webhook: https://api.telegram.org/bot{TOKEN}/setWebhook?url={YOUR_URL}/api/telegram/webhook
#
# 3. DeepSeek API (for NLP parsing):
#    - Sign up at platform.deepseek.com
#    - Create API key
#    - Falls back to: local Ollama (qwen3-coder), then rule-based parser
#    - No API key = auto fallback to local
#
# 4. Vercel Deployment:
#    - Push to GitHub
#    - Import to Vercel
#    - Add all environment variables
#    - Deploy!