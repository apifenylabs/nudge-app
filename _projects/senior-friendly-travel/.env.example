# ── Affiliate IDs ───────────────────────────────────────────────────────
# After signing up for each affiliate program, replace the placeholder
# values below with your real IDs. These env vars power all affiliate links
# across the site.
#
# Provider           | Sign-up URL                                   | Commission
# ───────────────────┼───────────────────────────────────────────────┼────────────
# Klook              | https://affiliate.klook.com                   | 3-6%
# Viator             | https://www.viator.com/affiliates             | 4-8%
# Booking.com        | https://partner.booking.com                  | ~4%
# Agoda              | https://partner.agoda.com                     | 3-5%
# GetYourGuide       | https://partner.getyourguide.com              | 6-10%
# Expedia            | https://expediapartnersolutions.com           | 3-5%
# Tripadvisor        | https://www.tripadvisor.com/affiliates        | ~50% rev share

# Klook — aff_adid parameter
NEXT_PUBLIC_AFFILIATE_KLOOK=38VWJMX

# Viator — pid parameter
NEXT_PUBLIC_AFFILIATE_VIATOR=455806

# Booking.com — aid parameter (legacy key also works)
NEXT_PUBLIC_AFFILIATE_BOOKING_COM=
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=2875669

# Agoda — cid parameter
NEXT_PUBLIC_AFFILIATE_AGODA=

# GetYourGuide — partner_id parameter
NEXT_PUBLIC_AFFILIATE_GETYOURGUIDE=

# Expedia — msp_cid parameter
NEXT_PUBLIC_AFFILIATE_EXPEDIA=

# Tripadvisor — partner_id parameter
NEXT_PUBLIC_AFFILIATE_TRIPADVISOR=

# Legacy fallback keys (used by PriceComparisonWidget component)
NEXT_PUBLIC_KLOOK_AFFILIATE_ID=38VWJMX
NEXT_PUBLIC_VIATOR_AFFILIATE_ID=455806

# ── Mapbox (optional) ──────────────────────────────────────────────────
# For interactive maps on destination pages. Get a token at:
#   https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Analytics ───────────────────────────────────────────────────────────
# Google Analytics tracking ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_TRACKING_ID=

# PostHog project key (optional)
NEXT_PUBLIC_POSTHOG_KEY=
