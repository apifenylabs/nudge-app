    "funnel_stage": "awareness",
    "cta_headline": "Find the perfect AI localization tool for your workflow",
    "cta_body": "Browse our curated directory of 85+ AI tools tested for Asian solopreneurs, including translation, localization, and content tools.",
    "cta_button_text": "Explore Tools",
    "cta_button_link": "/tools",
    "affiliate_links": [
      {
        "text": "Try DeepL Pro",
