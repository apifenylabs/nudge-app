    "funnel_stage": "consideration",
    "cta_headline": "Find the perfect AI finance tool for your business",
    "cta_body": "Browse our curated directory of 85+ AI tools tested for Asian solopreneurs, including accounting, invoicing, and finance tools.",
    "cta_button_text": "Explore Tools",
    "cta_button_link": "/tools",
    "affiliate_links": [
      {
        "text": "Try Xero",
