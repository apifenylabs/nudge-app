# =============================================================================
# APIFENY.AI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NOTE: Only NEXT_PUBLIC_* vars are exposed to the browser.
# Keep server-side secrets (API keys, DB creds) out of NEXT_PUBLIC_.
# =============================================================================

# ---------------------------------------------------------------------------
# AFFILIATE PROGRAM IDs
# ---------------------------------------------------------------------------
# To activate affiliate commissions, join the programs below and set your IDs.
# Until you set a var, the component falls back to plain (non-affiliate) URLs.
# See AFFILIATE_SETUP.md for sign-up instructions for each program.
#
# These are used by /api/redirect?tool={slug} to build the final URL server-side.

# Notion AI — 50% recurring for 12 months
# Join: https://www.notion.so/affiliates
# NEXT_PUBLIC_AFFILIATE_NOTION=your-ref-code

# Jasper AI — 30% recurring
# Join: https://jasper.ai/affiliates (via PartnerStack)
# NEXT_PUBLIC_AFFILIATE_JASPER=your-partnerstack-id

# Copy.ai — 45% first year, then lower
# Join: https://www.copy.ai/affiliates (via Impact)
# NEXT_PUBLIC_AFFILIATE_COPYAI=your-impact-id

# Writesonic — 30% lifetime recurring
# Join: https://writesonic.com/affiliates
# NEXT_PUBLIC_AFFILIATE_WRITESONIC=your-ref-code

# Canva — Flat fee per conversion
# Join: https://www.canva.com/affiliates
# NEXT_PUBLIC_AFFILIATE_CANVA=your-canva-aff-id

# Synthesia — Up to 30% recurring
# Join: https://www.synthesia.io/affiliates
# NEXT_PUBLIC_AFFILIATE_SYNTHESIA=your-synthesia-id

# HeyGen — Flat fee per signup or recurring
# Join: https://www.heygen.com/affiliates
# NEXT_PUBLIC_AFFILIATE_HEYGEN=your-heygen-id

# Runway — 20% recurring
# Join: https://runwayml.com/affiliates
# NEXT_PUBLIC_AFFILIATE_RUNWAY=your-runway-id

# Descript — 20% recurring
# Join: https://www.descript.com/affiliates
# NEXT_PUBLIC_AFFILIATE_DESCRIPT=your-descript-id

# ElevenLabs — 20% recurring
# Join: https://elevenlabs.io/affiliates
# NEXT_PUBLIC_AFFILIATE_ELEVENLABS=your-elevenlabs-id

# Murf AI — 20% recurring for 24 months
# Join: https://murf.ai/affiliate-program
# NEXT_PUBLIC_AFFILIATE_MURF=your-murf-id

# Make.com — 20% recurring
# Join: https://www.make.com/en/affiliates
# NEXT_PUBLIC_AFFILIATE_MAKE=your-make-id

# SurferSEO — 25% recurring
# Join: https://surferseo.com/affiliate-program
# NEXT_PUBLIC_AFFILIATE_SURFERSEO=your-surfer-id

# Semrush — $200-450 flat per sale
# Join: https://www.semrush.com/affiliates/
# NEXT_PUBLIC_AFFILIATE_SEMRUSH=your-semrush-id

# Zapier — 20-25% recurring
# Join: https://zapier.com/affiliates
# NEXT_PUBLIC_AFFILIATE_ZAPIER=your-zapier-id

# Intercom — Partner program (recurring)
# Join: https://www.intercom.com/partners
# NEXT_PUBLIC_AFFILIATE_INTERCOM=your-intercom-id

# ---------------------------------------------------------------------------
# REFERRAL / FRIEND-INVITE LINKS (no affiliate account needed)
# ---------------------------------------------------------------------------
# These are built into the /api/redirect route using the raw IDs below.
# Some tools offer referral bonus tokens/credits when a friend signs up via your link.

# Bolt.new — referral bonus tokens
# Generate your link at: https://bolt.new/settings/referrals
# NEXT_PUBLIC_REFERRAL_BOLT=your-bolt-ref

# Windsurf — referral bonus flex credits
# Generate your link at: https://windsurf.com/referrals
# NEXT_PUBLIC_REFERRAL_WINDSURF=your-windsurf-ref

# Replit — $10 per friend upgrade (Core plan)
# Generate your link at: https://replit.com/account/referrals
# NEXT_PUBLIC_REFERRAL_REPLIT=your-replit-ref

# Notion (personal) — Notion AI trial credits
# Generate your link at: https://www.notion.so/my-integrations/referrals
# NEXT_PUBLIC_REFERRAL_NOTION=your-notion-ref

# ---------------------------------------------------------------------------
# SITE-SPECIFIC (optional)
# ---------------------------------------------------------------------------

# Google Analytics (GA4) — set in Vercel env vars for production
# Create a GA4 property: https://analytics.google.com
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Vercel Analytics & Speed Insights — enabled by default via @vercel/analytics

# ---------------------------------------------------------------------------
# STRIPE (payments & checkout)
# ---------------------------------------------------------------------------
# Get your secret key from https://dashboard.stripe.com/apikeys
# Keep this server-side only (never in NEXT_PUBLIC_ prefix).
# For local dev, set in .env.local. For production, set in Vercel env vars.
# STRIPE_SECRET_KEY=sk_test_placeholder

# ---------------------------------------------------------------------------
# THIRD-PARTY SERVICES
# ---------------------------------------------------------------------------

# RESEND (email delivery for PDF purchases + newsletter)
# Sign up at https://resend.com + add your domain
# Free tier: 100 emails/day — enough to start
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Stripe webhook secret (optional for now, enables signature verification)
# Create endpoint in Stripe Dashboard: https://dashboard.stripe.com/webhooks
# Point to: https://apifeny-ai.vercel.app/api/stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Supabase (for contact forms, reviews, etc.)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
